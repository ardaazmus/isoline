{
  "name": "surdurulebilirlik-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "locales": "node scripts/gen-locales.mjs",
    "factors": "node scripts/build-factors.mjs",
    "predev": "node scripts/gen-locales.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/gen-locales.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "pretest": "node scripts/gen-locales.mjs",
    "test": "vitest run",
    "validate": "node scripts/validation/report.mjs",
    "validate:build": "node scripts/validation/build-cases.mjs && node scripts/validation/real-cases.mjs",
    "typecheck": "next typegen && tsc --noEmit",
    "db:bootstrap": "tsx scripts/db/cli.ts bootstrap",
    "db:migrate": "tsx scripts/db/cli.ts migrate",
    "db:rollback": "tsx scripts/db/cli.ts rollback",
    "db:status": "tsx scripts/db/cli.ts status",
    "db:seed": "tsx scripts/db/cli.ts seed",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:e2e": "playwright test",
    "db:types": "node --env-file=.env.local node_modules/kysely-codegen/dist/cli/bin.js --url \"env(DATABASE_OWNER_URL)\" --dialect postgres --default-schema public --include-pattern \"(public|core|authz).*\" --exclude-pattern \"*.kysely_*\" --date-parser string --type-mapping \"{\\\"int8\\\":\\\"number\\\"}\" --out-file src/server/db/schema.d.ts",
    "worker": "tsx scripts/worker.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1146.0",
    "@aws-sdk/s3-request-presigner": "3.1146.0",
    "better-auth": "1.7.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "d3-shape": "^3.2.0",
    "docx": "^9.12.0",
    "kysely": "0.29.6",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "nodemailer": "10.0.14",
    "pg": "8.23.1",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "^3.7.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz",
    "zod": "4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/turbopack": "^4",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/d3-shape": "^3.2.0",
    "@types/node": "^20",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "fast-check": "^4.10.2",
    "jszip": "^3.10.2",
    "kysely-codegen": "0.20.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
