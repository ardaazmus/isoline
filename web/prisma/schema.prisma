// Sunucu tarafı veri modeli (Faz 3–4 iskeleti).
// 6 katmanlı hiyerarşi: Workspace > Organization > LegalEntity > Facility > CostCenter > MetricTask.
// 6 rol + dönem/görev/kanıt/faktör kasası/denetim günlüğü. RLS Faz 4'te migration ile eklenecek
// (bkz. docs/SERVER_KURULUM.md). Prisma 6 çizgisi; MongoDB değil, SQL akışı.
//
// Aktivasyon: npm i -D prisma && npm i @prisma/client pg
//             npx prisma migrate dev --schema web/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// 6 temel rol (iş akışı §4.1). Sıralama yetki büyüklüğü DEĞİLDİR; yetki PERMISSIONS matrisindedir.
enum Role {
  WORKSPACE_OWNER
  COMPANY_ADMIN
  DATA_CONTRIBUTOR
  DATA_OWNER
  NARRATIVE_WRITER
  EXTERNAL_AUDITOR
}

/// GHG Protocol konsolidasyon yaklaşımı (düğüm başına seçilir).
enum ConsolidationMethod {
  OPERATIONAL
  FINANCIAL
  EQUITY
}

/// Görev durumu — kanıt kapısı: IN_REVIEW'e geçişte evidence zorunlu (Kural 2).
enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  APPROVED
  REJECTED
  SEALED
}

/// Raporlama dönemi durumu.
enum PeriodStatus {
  SETUP
  DATA_COLLECTION
  REVIEW
  SEALED
}

model Workspace {
  id    String @id @default(cuid())
  name  String
  orgs  Organization[]
  members Membership[] @relation("WorkspaceMembers")
  createdAt DateTime @default(now())
}

model Organization {
  id          String @id @default(cuid())
  workspaceId String
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  entities    LegalEntity[]
  members     Membership[] @relation("OrgMembers")
  periods     ReportingPeriod[]
  createdAt   DateTime @default(now())
}

model LegalEntity {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  /// Özkaynak payı yüzdesi (0–100); EQUITY yönteminde çarpan.
  equityShare    Float  @default(100)
  facilities     Facility[]
}

model Facility {
  id            String @id @default(cuid())
  legalEntityId String
  legalEntity   LegalEntity @relation(fields: [legalEntityId], references: [id], onDelete: Cascade)
  name          String
  kind          String @default("factory")
  /// Bu düğümün konsolidasyon kuralı.
  control       ConsolidationMethod @default(OPERATIONAL)
  /// Özkaynak payı yüzdesi (0–100); EQUITY yönteminde çarpan.
  equityShare   Float @default(100)
  costCenters   CostCenter[]
}

model CostCenter {
  id         String @id @default(cuid())
  facilityId String
  facility   Facility @relation(fields: [facilityId], references: [id], onDelete: Cascade)
  name       String
  tasks      MetricTask[]
}

/// Katman 6: hesaplama aracı sözleşmesi (wrapper mimarisi §5).
/// Her görev bir araca + dönem dilimine + standart birime bağlanır.
model MetricTask {
  id           String @id @default(cuid())
  costCenterId String
  costCenter   CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  tool         String
  /// Aylık/çeyreklik/yıllık dilim etiketi, örn. "2026-03".
  periodSlice  String
  unit         String @default("tCO2e")
  value        Float?
  /// Tahmini/ölçülen/hesaplanan veri kalitesi.
  quality      String @default("measured")
  status       TaskStatus @default(TODO)
  assigneeId   String?
  assignee     Membership? @relation(fields: [assigneeId], references: [id])
  justification String?
  evidences    EvidenceFile[]
  findings     ValidationFinding[]
  updatedAt    DateTime @updatedAt
}

model Membership {
  id            String @id @default(cuid())
  workspaceId   String?
  workspace     Workspace? @relation("WorkspaceMembers", fields: [workspaceId], references: [id], onDelete: Cascade)
  organizationId String?
  organization  Organization? @relation("OrgMembers", fields: [organizationId], references: [id], onDelete: Cascade)
  /// Gerçek kimlik sağlayıcı (IdP) kullanıcı kimliği; bu iskelette opak dize.
  subject       String
  role          Role
  tasks         MetricTask[]
  createdAt     DateTime @default(now())

  @@index([organizationId, role])
}

model ReportingPeriod {
  id             String @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  baseYear       Int
  status         PeriodStatus @default(SETUP)
}

/// Kanıt dosyası üstverisi (PDF fatura vb.). Dosya gövdesi nesne deposunda durur, burada yolu tutulur.
model EvidenceFile {
  id          String @id @default(cuid())
  taskId      String
  task        MetricTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  objectKey   String
  sha256      String
  uploadedBy  String
  uploadedAt  DateTime @default(now())
}

/// Emisyon faktörü kasası (§5.1): hardcoded katsayılar buraya taşınır, sürümlenir.
model FactorSet {
  id        String @id @default(cuid())
  name      String
  version   String
  published Boolean @default(false)
  factors   Factor[]
}

/// Tek katsayı satırı: DEFRA/IPCC/ETKB vb. kaynak + değer + birim + geçerlilik.
model Factor {
  id        String @id @default(cuid())
  setId     String
  set       FactorSet @relation(fields: [setId], references: [id], onDelete: Cascade)
  code      String
  value     Float
  unit      String
  source    String
  validFrom String?

  @@index([setId, code])
}

/// Anomali motoru bulgusu (§5.4): YoY sapma ±%30 (uyarı + gerekçe zorunlu), eksik kanıt (kapı).
model ValidationFinding {
  id        String @id @default(cuid())
  taskId    String
  task      MetricTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  rule      String
  severity  String @default("warn")
  detail    String?
  createdAt DateTime @default(now())
}

/// Değişmez denetim günlüğü: denetçi buradan okur, kimse buraya yazamaz (uygulama katmanı uygular).
model AuditLog {
  id             String @id @default(cuid())
  organizationId String
  actor          String
  action         String
  entityRef      String
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
}
