# Kopyala: cp .env.example .env  (repo'ya .env commit'leme — .gitignore'da)
POSTGRES_USER=isoline
POSTGRES_PASSWORD=isoline-dev-gelistirme-sifresi
POSTGRES_DB=isoline
# NOT: 5432 doluysa (bu makinede dolu) başka port ver, örn. 5544
POSTGRES_PORT=5544
WEB_PORT=3000

# Uygulamanın DB bağlantısı (compose içinde servis adı `db`; yerelde `localhost`)
DATABASE_URL=postgresql://isoline:isoline-dev-gelistirme-sifresi@localhost:5544/isoline?schema=public

# Oturum imzalama anahtarı — üretimde `openssl rand -base64 48` ile üret, kimseyle paylaşma
AUTH_SECRET=dev-secret-change-me
