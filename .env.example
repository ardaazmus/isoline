# Do not copy by hand: `node scripts/dev-env.mjs` writes .env (Docker Compose) and web/.env.local (app, worker,
# tests) with random secrets. This file only lists the names. See docs/SERVER_KURULUM.md.

# ---- .env (Docker Compose)
PG_PORT=5545
S3_PORT=8333
MAIL_SMTP_PORT=1125
MAIL_UI_PORT=8125
CLAMAV_PORT=3310
PG_SUPERUSER_PASSWORD=
CLOUDFLARE_TUNNEL_TOKEN=

# ---- web/.env.local (Next.js, worker, tests)
# DATABASE_ADMIN_URL=postgres://postgres:...@127.0.0.1:5545/postgres
# DATABASE_OWNER_URL=postgres://isoline_owner:...@127.0.0.1:5545/isoline
# DATABASE_URL=postgres://isoline_app:...@127.0.0.1:5545/isoline
# DATABASE_SYSTEM_URL=postgres://isoline_system:...@127.0.0.1:5545/isoline
# DB_OWNER_PASSWORD= DB_APP_PASSWORD= DB_SYSTEM_PASSWORD=
# BETTER_AUTH_SECRET=            48+ random bytes
# BETTER_AUTH_URL=http://localhost:3210
# APP_BASE_URL=http://localhost:3210
# APP_ENCRYPTION_KEY=            32 random bytes, base64url
# S3_ENDPOINT=http://127.0.0.1:8333  S3_REGION=us-east-1  S3_BUCKET=isoline-evidence  S3_ACCESS_KEY=  S3_SECRET_KEY=
# EMAIL_SMTP_HOST=127.0.0.1  EMAIL_SMTP_PORT=1125  EMAIL_FROM=Isoline <no-reply@isoline.local>
# MAIL_API_URL=http://127.0.0.1:8125
# SCANNER=dev|clamav  CLAMAV_HOST=127.0.0.1  CLAMAV_PORT=3310
# OIDC_ISSUER=  OIDC_CLIENT_ID=  OIDC_CLIENT_SECRET=     (optional enterprise SSO)
